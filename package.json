{
  "name": "litora-react-project",
  "version": "1.0.0",
  "description": "Litora rebuilt as a HubSpot CMS theme in React (platform 2025.2)",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix src/theme/litora-react",
    "start": "npm run start --prefix src/theme/litora-react",
    "storybook": "npm run storybook --prefix src/theme/litora-react",
    "build:css": "node scripts/build-global-css.mjs",
    "build:templates": "node scripts/build-templates.mjs",
    "build": "npm run build:css && npm run build:templates",
    "check": "node scripts/app-checks.cjs lang tokens hardcoded",
    "test": "vitest run",
    "upload": "npm run build && npm run check && npm test && hs project upload"
  },
  "devDependencies": {
    "@hubspot/cli": "^8.16.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^2.1.8"
  }
}
