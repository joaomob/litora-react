{
  "name": "litora-react-project",
  "version": "1.0.0",
  "description": "Litora rebuilt as a HubSpot CMS theme in React (platform 2025.2)",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix src/theme/litora-react",
    "start": "npm run start --prefix src/theme/litora-react",
    "storybook": "node scripts/storybook.mjs",
    "build:css": "node scripts/build-global-css.mjs",
    "build:templates": "node scripts/build-templates.mjs",
    "build": "npm run build:css && npm run build:js && npm run build:templates",
    "check": "node scripts/app-checks.cjs lang tokens hardcoded",
    "typecheck": "tsc -p src/theme/litora-react",
    "test": "vitest run",
    "upload": "npm run verify && hs project upload",
    "build:js": "node scripts/build-scripts.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:generated": "git diff --exit-code -- src/theme/litora-react/templates src/theme/litora-react/css src/theme/litora-react/js src/theme/litora-react/storybook",
    "verify": "npm run build && npm run check && npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hubspot/cli": "^8.16.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
